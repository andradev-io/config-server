# Copy to .env and fill in. .env is git-ignored; this file is not.
# Names use the .NET configuration convention: "__" separates sections (ConfigSource__Path = ConfigSource:Path).

# --- Config source (folder with the config files, e.g. a clone of the config repo) ---
ConfigSource__Path=E:/_Development/_repos/dev-vinicius-andrade/config-server-files-local

# --- Authentication: None (Development only) or Oidc ---
Auth__Mode=None
Auth__Oidc__Authority=http://localhost:8080/realms/<realm>
Auth__Oidc__ClientId=config-manager-web
# Defaults to ClientId when empty
Auth__Oidc__Audience=
Auth__Oidc__RequireHttpsMetadata=false
# Keycloak client roles: resource_access.{clientId}.roles
Auth__Oidc__RoleClaim=resource_access.{clientId}.roles

# --- Identity admin: manage grants from the site (Provider=None disables it) ---
IdentityAdmin__Provider=None
IdentityAdmin__Keycloak__BaseUrl=http://localhost:8080
IdentityAdmin__Keycloak__Realm=<realm>
IdentityAdmin__Keycloak__AdminClientId=config-manager-admin
# Secret of the config-manager-admin client (Credentials tab). Never commit it.
IdentityAdmin__Keycloak__AdminClientSecret=
# Client that holds the config:* roles (defaults to Auth__Oidc__ClientId)
IdentityAdmin__Keycloak__ConfigClientId=
# Optional: public token endpoint shown for OIDC API keys. Defaults to {Auth__Oidc__Authority}/protocol/openid-connect/token.
# IdentityAdmin__Keycloak__TokenEndpoint=

# --- API keys store (keep outside the config Git repo) ---
ApiKeys__StorePath=data/api-keys.json

# --- Optional: discovery document URL when the API reaches the IdP on another address than the public Authority ---
# Auth__Oidc__MetadataAddress=http://idp.internal:9000/idp/.well-known/openid-configuration

# --- Optional: behind a reverse proxy, honour X-Forwarded-For/Proto/Host (off by default; never trust an open port) ---
# ForwardedHeaders__Enabled=true
# ForwardedHeaders__KnownNetworks__0=10.42.0.0/16
# ForwardedHeaders__TrustAllProxies=false

# --- Public sandbox (each signed-in visitor gets a private, disposable copy of the template). Needs Auth__Mode=Oidc and
# --- IdentityAdmin__Provider=None; identity management is simulated. Never point it at real data.
# Demo__Enabled=true
# Demo__TemplatePath=./demo-data
# Demo__WorkspacesPath=/tmp/config-demo-workspaces
# Demo__IdleTtlMinutes=120
# Demo__MaxWorkspaces=200
# Demo__MaxBytesPerWorkspace=2097152
# Demo__MaxFilesPerWorkspace=100
# Demo__MaxApiKeysPerWorkspace=20
# Demo__RequestsPerMinute=300
# Demo__MaxRequestBodyBytes=262144
# Demo__Notice=
# Demo__TokenEndpoint=https://demo.example.com/idp/token
