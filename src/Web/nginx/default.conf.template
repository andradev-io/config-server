# Rendered at container start by the nginx image (envsubst, only DEMO_* variables, see NGINX_ENVSUBST_FILTER):
#   DEMO_API_UPSTREAM   host:port of the config server API   (default config-demo-api:8080)
#   DEMO_IDP_UPSTREAM   host:port of the demo OIDC provider  (default config-demo-idp:9000)
# One public origin serves the SPA, the API (/api, /config, /health) and the IdP (/idp), so the SPA is built with
# VITE_API_BASE_URL=/ and there is no CORS.

# The scheme the visitor used: Traefik/Cloudflare terminate TLS in front, so trust their header when present.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# Per visitor address for the rate limit (Cloudflare header first, else the connecting address).
map $http_cf_connecting_ip $limit_key {
    default $http_cf_connecting_ip;
    ''      $binary_remote_addr;
}
limit_req_zone $limit_key zone=demo_api:10m rate=30r/s;
limit_req_zone $limit_key zone=demo_idp:10m rate=5r/s;
limit_req_status 429;

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 1m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/yaml image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    # Platform probe (the API's own /health is proxied below).
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---- API (same origin)
    location ~ ^/(api|config)(/|$) {
        limit_req zone=demo_api burst=60 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://${DEMO_API_UPSTREAM};
    }

    location = /health {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://${DEMO_API_UPSTREAM};
    }

    # ---- identity provider (issuer https://<host>/idp); big headers: OIDC cookies
    location ^~ /idp/ {
        limit_req zone=demo_idp burst=20 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_buffer_size 16k;
        proxy_buffers 4 16k;
        proxy_pass http://${DEMO_IDP_UPSTREAM};
    }

    # ---- SPA: hashed assets never change, everything else falls back to index.html (client-side routes, the OIDC callback
    # `/?code=&state=` and the silent-renew iframe, which both load the SPA itself).
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location ~* \.(?:ico|png|svg|webmanifest)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        try_files $uri @spa;
    }

    location @spa {
        rewrite ^ /index.html break;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
