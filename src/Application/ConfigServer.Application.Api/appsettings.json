{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConfigSource": {
    "Path": "config-files",
    "AllowWrite": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "Mode": "Oidc",
    "Oidc": {
      "Authority": "",
      "Audience": "",
      "ClientId": "",
      "RequireHttpsMetadata": true,
      // Where the roles are in the token: a dotted path, or several separated by ',' (union). "{clientId}" is replaced by
      // ClientId, e.g. Keycloak: "roles,realm_access.roles,resource_access.{clientId}.roles".
      // Role strings: config:<read|write|admin>[:<app>[:<env>]] (app/env omitted or "*" = all; write includes read;
      // admin is global only). Examples: config:read, config:write:billing-service, config:read:billing-service:prd.
      "RoleClaim": "roles",
      // External role/group name (case-insensitive, no ':') => config role string(s), comma separated,
      // e.g. "billing-devs": "config:write:billing-service:dev,config:read:billing-service:stg".
      "RoleMap": {}
    }
  },
  "ApiKeys": {
    "StorePath": "data/api-keys.json"
  },
  // Public sandbox: every signed-in visitor (token sub) gets an isolated, disposable copy of TemplatePath under
  // WorkspacesPath, deleted after IdleTtlMinutes without use. Needs Auth:Mode=Oidc and IdentityAdmin:Provider=None
  // (identity management is simulated). Never point it at real data.
  "Demo": {
    "Enabled": false,
    "TemplatePath": "",
    "WorkspacesPath": "",
    "IdleTtlMinutes": 120,
    "MaxWorkspaces": 200,
    "MaxBytesPerWorkspace": 2097152,
    "MaxFilesPerWorkspace": 100
  },
  // Lets a global config:admin manage who holds which grants (api/access) by driving the identity provider's admin API.
  // The identity provider stays the source of truth: a grant is a client role config:<perm>[:<app>[:<env>]] of
  // Keycloak:ConfigClientId mapped to a user or group; it takes effect at the subject's next token refresh/sign-in.
  // Provider: None (default; api/access answers 501) | Keycloak. Setup steps: docs/keycloak-setup.md.
  "IdentityAdmin": {
    "Provider": "None",
    "Keycloak": {
      // Keycloak base URL including any context path (e.g. https://keycloak.example.com, or https://host/auth before
      // Keycloak 17). Must be https unless it is a loopback address or RequireHttps=false (private network only).
      "BaseUrl": "",
      "Realm": "",
      // Confidential client with "Service accounts roles" on (client_credentials), see docs/keycloak-setup.md.
      "AdminClientId": "config-manager-admin",
      // AdminClientSecret: never in this file. Set IdentityAdmin__Keycloak__AdminClientSecret in the environment or a
      // secret store; it is never logged or returned.
      // Client (clientId) whose roles carry the grants; empty = Auth:Oidc:ClientId.
      "ConfigClientId": "",
      "RequireHttps": true,
      "TimeoutSeconds": 15
    }
  }
}
